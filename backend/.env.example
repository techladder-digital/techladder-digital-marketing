# ------------------------------------------------------------------
# TechLadder backend configuration — copy to .env and fill in values.
# These are PLACEHOLDERS, not real credentials. Never commit .env.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Comma-separated list of exact frontend origins allowed by CORS.
FRONTEND_URL=http://localhost:4200
# Set to 1 when running behind one reverse proxy (Nginx, a PaaS load balancer)
# so rate limiting sees the real client IP.
TRUST_PROXY=0

# --- MySQL 8+ -------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Ramesh@1045
DB_NAME=techladder_db
DB_CONNECTION_LIMIT=10
# Set to true when your managed MySQL requires TLS.
DB_SSL=false

# --- Admin authentication ------------------------------------------
# Long random string (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=1ddf02ecbd53b1691c50236a5b6bb6ad2cbb845e0ba1afec65fd5279bfccbac54d95d35ec62b9ed2e5930486f19b6038
JWT_EXPIRES_IN_MINUTES=30

# --- Email (SMTP via Nodemailer) — optional --------------------------
# Leave SMTP_HOST empty to disable email notifications (enquiries are still saved).
SMTP_HOST=your_smtp_host
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=replace_me
EMAIL_FROM="TechLadder Website <no-reply@example.com>"
BUSINESS_EMAIL=your_business_email

# --- WhatsApp Business Platform (Cloud API) — optional ---------------
# Leave WHATSAPP_ACCESS_TOKEN empty to disable automatic WhatsApp notifications.
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me
# Business number that receives enquiry alerts, international format, digits only (e.g. 919876543210)
WHATSAPP_BUSINESS_RECIPIENT=replace_me
WHATSAPP_API_VERSION=v21.0
# Name and language of an APPROVED message template (see README).
WHATSAPP_TEMPLATE_NAME=new_enquiry_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
# Webhook settings for delivery status updates
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_me
WHATSAPP_APP_SECRET=replace_me

# --- Live follower counts (official APIs) — optional -----------------
# YouTube Data API v3 key (read-only, public channel statistics)
YOUTUBE_API_KEY=
# Meta Graph API token with access to your Facebook Page / Instagram professional account
META_GRAPH_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
# How often to refresh API-backed follower counts (minutes, 0 = disabled)
SOCIAL_SYNC_INTERVAL_MINUTES=360

# --- Photo / video uploads (admin panel) -----------------------------
# Folder where uploaded files are stored (relative to the backend folder, or absolute).
# Back this folder up together with the database.
UPLOAD_DIR=uploads
MAX_IMAGE_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=100

# --- Notification retry worker ---------------------------------------
NOTIFICATION_RETRY_INTERVAL_SECONDS=120
NOTIFICATION_MAX_ATTEMPTS=5
