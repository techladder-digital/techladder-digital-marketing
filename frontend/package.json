{
  "name": "techladder-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "TechLadder Digital Marketing — Angular website and admin panel",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:prod": "node scripts/set-env.mjs && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "20.3.33",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/forms": "20.3.33",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.33",
    "@angular/router": "20.3.33",
    "@fontsource/inter": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "bootstrap": "5.3.8",
    "material-icons": "1.13.14",
    "ngx-toastr": "19.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.39",
    "@angular/cli": "20.3.39",
    "@angular/compiler-cli": "20.3.33",
    "@angular/platform-browser-dynamic": "20.3.33",
    "@eslint/js": "9.39.5",
    "@types/jest": "30.0.0",
    "angular-eslint": "20.7.0",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-preset-angular": "15.0.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
