# Frontend configuration (NON-SECRET values only — everything here ships to browsers).
# Used by `npm run build:prod` (scripts/set-env.mjs) to write src/environments/environment.prod.ts.
#
# Same-origin deployment (recommended — reverse proxy serves /api): keep /api
# Separate API domain: https://api.yourdomain.com/api  (also add the site origin to backend FRONTEND_URL)
API_BASE_URL=/api
# Public site URL, used for canonical / Open Graph URLs
SITE_URL=https://www.yourdomain.com
